#!/usr/bin/env bash
# Allowlisted Containerlab gateway for the MCP server.
#
# The MCP server reaches this lab host (a VM or a bare-metal Linux machine) only as
#   ssh <host> /usr/local/libexec/clab-mcp-remote <action> [args...]
# so this script is the trust boundary. It re-validates every name, address and
# CLI line even though the Node server validates them first. It never accepts raw
# Containerlab YAML (it renders topologies itself from a node/link list), never
# accepts an FRR `daemons` file (FRR's init script sources it as shell), and
# never lets a router CLI request reach a Linux shell: Containerlab nodes run
# privileged, so a shell inside a router is a shell on this lab host.
set -euo pipefail
umask 022
export LC_ALL=C

# Raise this whenever an action or its output changes. The MCP server compares
# it with its own number, so an install that was not rerun is noticed.
HELPER_VERSION=5
STATE_ROOT=/var/lib/containerlab-mcp
LABS="$STATE_ROOT/labs"
# Built by install-remote.sh from remote/frr (stock FRR plus lab-start and lab-netdev-sync).
FRR_IMAGE=lab-dojo/frr:10.7.1
# Built by install-remote.sh from remote/host: Alpine Linux with network tools.
HOST_IMAGE=lab-dojo/host:1
# Containerlab itself, for a host where it is not installed. install-remote.sh
# pulls it only on such a host; this helper never pulls.
CLAB_IMAGE=ghcr.io/srl-labs/clab:0.82.0
# Other images a host node may run: "<name> <image-ref>" per line. Nodes run
# privileged, so an image is as trusted as root on this lab host. Only a person adds
# one, with clab-mcp-admin; this helper only reads the file, and only when root
# owns it.
IMAGES_FILE=/etc/containerlab-mcp/images
LINK_MTU=1500
MAX_LABS=6
MAX_NODES=16
MAX_CEOS_PER_LAB=6
MAX_CEOS_RUNNING=8
MAX_LINKS=48
MAX_SPEC_BYTES=16384
MAX_CONFIG_BYTES=65536
MAX_CONFIG_LINES=600
MAX_SESSION_LINES=200
MAX_META_BYTES=262144

# First words that can leave configuration mode, run exec-mode commands, write
# files or start a shell on FRR (vtysh) or Arista EOS. Both CLIs accept
# abbreviations, so a word is refused when it equals one of these or is a prefix
# of one ("ev" -> event-handler, "st" -> start-shell, "en" -> end/enable).
DENY_FIRST_WORDS=(
  do end exit quit start-shell write copy configure enable disable terminal run
  bash event-handler alias schedule daemon extension python python-shell
  zerotouch reload boot send delete rename tcpdump more ssh telnet connect install
)
# Saved configuration files legitimately use these to close a section.
STARTUP_MODE_EXITS=(end exit quit)
DENY_SUBSTRINGS=(bash shell python sudo /bin/ /usr/ /sbin/)

die() {
  printf 'clab-mcp-remote: %s\n' "$*" >&2
  exit 2
}

# Containerlab: the installed program if there is one, else CLAB_IMAGE as a
# short-lived container. That container drives the host's Docker, so the lab
# routers are its siblings, not its children. The mounts are the ones the
# Containerlab docs prescribe. Containerlab passes lab file paths to the host's
# Docker, so $STATE_ROOT is mounted at the same path.
clab() {
  if type -P clab >/dev/null; then
    command clab "$@"
    return
  fi
  docker run --rm --pull never --privileged --network host --pid host \
    -v /var/run/docker.sock:/var/run/docker.sock \
    -v /var/run/netns:/var/run/netns \
    -v /var/lib/docker/containers:/var/lib/docker/containers \
    -v /etc/hosts:/etc/hosts \
    -v "$STATE_ROOT:$STATE_ROOT" -w "$PWD" \
    "$CLAB_IMAGE" containerlab "$@"
}

valid_lab_name() { [[ ${1:-} =~ ^[a-z][a-z0-9-]{0,19}$ ]]; }
valid_node_name() { [[ ${1:-} =~ ^[a-z][a-z0-9-]{0,14}$ ]]; }
valid_image_name() { [[ ${1:-} =~ ^[a-z][a-z0-9-]{0,19}$ ]]; }
valid_image_ref() { [[ ${1:-} =~ ^[A-Za-z0-9][A-Za-z0-9._/:@-]{0,199}$ ]]; }
# Data-plane interfaces only. eth0 is the management interface.
valid_iface() { [[ ${1:-} =~ ^eth[1-9][0-9]?$ ]]; }
valid_uint() { [[ ${1:-} =~ ^[0-9]{1,6}$ ]] && ((10#$1 >= $2 && 10#$1 <= $3)); }

valid_ip_literal() {
  local value=${1:-} octet
  local -a octets
  if [[ $value == *.* && $value != *:* ]]; then
    IFS=. read -r -a octets <<< "$value"
    ((${#octets[@]} == 4)) || return 1
    for octet in "${octets[@]}"; do
      [[ $octet =~ ^[0-9]{1,3}$ ]] || return 1
      ((10#$octet <= 255)) || return 1
    done
    return 0
  fi
  # IPv6-like characters only, never a hostname or option. ping performs the
  # final IPv6 syntax validation.
  [[ $value == *:* && $value =~ ^[0-9A-Fa-f:.]+$ ]]
}

# Arista images need a sign-in, so the user imports one as ceos:<version>.
# cEOS is optional and any version works: the newest one present is used.
ceos_image() {
  docker images --format '{{.Repository}}:{{.Tag}}' ceos | grep -E '^ceos:[A-Za-z0-9._-]+$' | sort -V | tail -n 1 || true
}

# Registered extra images as "name ref" lines; nothing unless root owns the file.
extra_images() {
  [[ -f $IMAGES_FILE && $(stat -c %u "$IMAGES_FILE") == 0 ]] || return 0
  local name ref rest
  while read -r name ref rest; do
    valid_image_name "$name" && valid_image_ref "$ref" && [[ -z $rest ]] || continue
    printf '%s %s\n' "$name" "$ref"
  done < "$IMAGES_FILE"
}

# The image a host node runs: the built-in one, or a registered one by name.
host_image() {
  local name=${1:-} ref
  if [[ -z $name ]]; then
    ref=$HOST_IMAGE
  else
    valid_image_name "$name" || die "invalid image name: $name"
    ref=$(extra_images | awk -v name="$name" '$1 == name {print $2; exit}')
    [[ -n $ref ]] || die "image '$name' is not registered on this lab host (a person adds it with clab-mcp-admin; see check_setup)"
  fi
  docker image inspect "$ref" >/dev/null 2>&1 || die "image $ref is not on this lab host (see check_setup)"
  printf '%s' "$ref"
}

read_stdin() {
  local limit=$1 data
  data=$(head -c $((limit + 1)))
  ((${#data} <= limit)) || die "input larger than $limit bytes"
  printf '%s' "$data"
}

require_lab() {
  valid_lab_name "${1:-}" || die 'invalid lab name'
  LAB=$1
  LAB_DIR="$LABS/$LAB"
  TOPO="$LAB_DIR/$LAB.clab.yml"
  [[ -f $TOPO ]] || die "lab $LAB is not defined"
}

require_node() {
  valid_node_name "${1:-}" || die 'invalid node name'
  [[ -f $LAB_DIR/nodes/$1 ]] || die "node $1 is not part of lab $LAB"
  NODE=$1
  KIND=$(<"$LAB_DIR/nodes/$NODE")
  CONTAINER="clab-$LAB-$NODE"
  [[ $KIND == frr || $KIND == ceos || $KIND == host ]] || die 'corrupt node record'
}

require_router() {
  [[ $KIND != host ]] || die "$NODE is a host: it has no router CLI or configuration"
}

require_running() {
  local state
  state=$(docker inspect --format '{{.State.Running}}' "$CONTAINER" 2>/dev/null || true)
  [[ $state == true ]] || die "node $NODE is not running (deploy lab $LAB first)"
}

require_node_iface() {
  valid_iface "${1:-}" || die 'invalid interface (use eth1, eth2, ...)'
  grep -qx -- "$1" "$LAB_DIR/ifaces/$NODE" || die "$1 is not a link interface of $NODE"
}

lab_running() {
  [[ -n $(docker ps -q --filter "label=containerlab=$LAB") ]]
}

cli() {
  case $KIND in
    frr) docker exec "$CONTAINER" vtysh -c "$1" ;;
    ceos) docker exec "$CONTAINER" Cli -p 15 -c "$1" ;;
  esac
}

# Validates one configuration line. Mode "session" is used for live changes and
# also refuses leaving configuration mode; mode "startup" is for saved files.
check_line() {
  local line=$1 mode=$2 lower first word
  ((${#line} <= 240)) || die 'configuration line longer than 240 characters'
  [[ $line =~ ^[[:print:]]*$ ]] || die 'configuration lines must be printable ASCII'
  case $line in
    *'|'* | *'>'* | *'<'* | *'`'* | *'$('* | *';'* | *'&'*) die "forbidden character in line: $line" ;;
    # Router configuration needs no file path. An address such as 10.1.2.1/30
    # has no space before its slash, so it still passes.
    /* | *' /'*) die "refused line (file paths are not allowed): $line" ;;
  esac
  lower=${line,,}
  for word in "${DENY_SUBSTRINGS[@]}"; do
    [[ $lower != *"$word"* ]] || die "refused line (contains '$word'): $line"
  done
  read -r first _ <<< "$lower" || true
  [[ -n ${first:-} && $first != '!'* ]] || return 0
  if [[ $mode == startup ]]; then
    for word in "${STARTUP_MODE_EXITS[@]}"; do
      [[ $first != "$word" ]] || return 0
    done
  fi
  for word in "${DENY_FIRST_WORDS[@]}"; do
    [[ $word != "$first"* ]] || die "refused line (first word '$first' is not allowed here): $line"
  done
}

# A host node has no router CLI, only a shell, so it gets no free-form commands.
# check_host_line accepts exact forms of ip, ethtool and cat /proc/net/bonding,
# on link interfaces and the bond, VLAN and dummy devices built on them, never
# on the management interface eth0. host_net runs the words without a shell.
HOST_LINK_RE='^eth[1-9][0-9]?$'
HOST_BOND_RE='^bond[0-9]{1,2}$'
HOST_DUMMY_RE='^dummy[0-9]{1,2}$'

host_vlan_ok() {
  [[ $1 =~ ^(eth[1-9][0-9]?|bond[0-9]{1,2})\.([0-9]{1,4})$ ]] && valid_uint "${BASH_REMATCH[2]}" 1 4094
}
host_virt_ok() { [[ $1 =~ $HOST_BOND_RE || $1 =~ $HOST_DUMMY_RE ]] || host_vlan_ok "$1"; }
host_if_ok() { [[ $1 =~ $HOST_LINK_RE ]] || host_virt_ok "$1"; }
host_cidr_ok() {
  local addr=${1%/*} max=32
  [[ $1 == */* ]] && valid_ip_literal "$addr" || return 1
  [[ $addr != *:* ]] || max=128
  valid_uint "${1##*/}" 0 "$max"
}

# Bond options as <key> <value> pairs, from word $1 of the caller's w.
host_bond_opts() {
  local i=$1 v
  while ((i < ${#w[@]})); do
    v=${w[i + 1]:-}
    case ${w[i]} in
      mode) [[ $v =~ ^(802\.3ad|active-backup|balance-(rr|xor|tlb|alb)|broadcast)$ ]] ;;
      lacp_rate) [[ $v == slow || $v == fast ]] ;;
      xmit_hash_policy) [[ $v =~ ^(layer2|layer2\+3|layer3\+4|encap2\+3|encap3\+4)$ ]] ;;
      ad_select) [[ $v =~ ^(stable|bandwidth|count)$ ]] ;;
      miimon | updelay | downdelay) valid_uint "$v" 0 60000 ;;
      min_links) valid_uint "$v" 0 64 ;;
      *) false ;;
    esac || return 1
    i=$((i + 2))
  done
}

host_ip_ok() {
  local i=1 j s dev
  while [[ ${w[i]:-} =~ ^-(br|brief|s|d|4|6|j|p)$ ]]; do i=$((i + 1)); done
  s=${w[*]:i}
  # Read: ip [flags] link|addr|address|route|neigh [show] [[dev] <if>]
  if [[ $s =~ ^(link|addr|address|route|neigh)( show)?(( dev)? ([a-z0-9.]+))?$ ]]; then
    [[ -z ${BASH_REMATCH[5]} ]] || host_if_ok "${BASH_REMATCH[5]}"
    return
  fi
  ((i == 1)) || return 1 # flags only on reads
  if [[ $s == 'link add link '* ]]; then
    ((${#w[@]} == 11)) && [[ ${w[4]} =~ $HOST_LINK_RE || ${w[4]} =~ $HOST_BOND_RE ]] &&
      [[ ${w[5]} == name && ${w[6]} == "${w[4]}.${w[10]}" && "${w[*]:7:3}" == 'type vlan id' ]] &&
      host_vlan_ok "${w[6]}"
  elif [[ $s == 'link add '*' type bond'* ]]; then
    [[ ${w[3]} =~ $HOST_BOND_RE && ${w[4]} == type && ${w[5]} == bond ]] && host_bond_opts 6
  elif [[ $s =~ ^link\ add\ ([a-z0-9]+)\ type\ dummy$ ]]; then
    [[ ${BASH_REMATCH[1]} =~ $HOST_DUMMY_RE ]]
  elif [[ $s =~ ^link\ (del|delete)(\ dev)?\ ([a-z0-9.]+)$ ]]; then
    host_virt_ok "${BASH_REMATCH[3]}"
  elif [[ $s == 'link set '* ]]; then
    j=3
    [[ ${w[j]:-} != dev ]] || j=4
    dev=${w[j]:-}
    j=$((j + 1))
    host_if_ok "$dev" && ((j < ${#w[@]})) || return 1
    if [[ ${w[j]} == type ]]; then
      [[ $dev =~ $HOST_BOND_RE && ${w[j + 1]:-} == bond ]] && host_bond_opts $((j + 2))
      return
    fi
    while ((j < ${#w[@]})); do
      case ${w[j]} in
        up | down | nomaster) j=$((j + 1)) ;;
        mtu) valid_uint "${w[j + 1]:-}" 68 9216 || return 1; j=$((j + 2)) ;;
        master) [[ ${w[j + 1]:-} =~ $HOST_BOND_RE ]] || return 1; j=$((j + 2)) ;;
        *) return 1 ;;
      esac
    done
  elif [[ $s =~ ^(addr|address)\ (add|del|delete)\ ([0-9A-Fa-f:./]+)\ dev\ ([a-z0-9.]+)$ ]]; then
    dev=${BASH_REMATCH[4]} # the checks below run regexes of their own
    host_cidr_ok "${BASH_REMATCH[3]}" && host_if_ok "$dev"
  elif [[ $s =~ ^(addr|address|neigh)\ flush\ dev\ ([a-z0-9.]+)$ ]]; then
    host_if_ok "${BASH_REMATCH[2]}"
  elif [[ $s =~ ^route\ (add|del|delete|replace)\ ([0-9A-Fa-f:./]+|default)(\ via\ ([0-9A-Fa-f:.]+))?(\ dev\ ([a-z0-9.]+))?$ ]]; then
    local dest=${BASH_REMATCH[2]} via=${BASH_REMATCH[4]} rdev=${BASH_REMATCH[6]}
    [[ -n $via || -n $rdev ]] || return 1
    [[ $dest == default ]] || host_cidr_ok "$dest" || return 1
    [[ -z $via ]] || valid_ip_literal "$via" || return 1
    [[ -z $rdev ]] || host_if_ok "$rdev"
  else
    return 1
  fi
}

check_host_line() {
  local line=$1 re='^[A-Za-z0-9 ./:_+-]*$'
  local -a w
  ((${#line} <= 200)) || die 'command longer than 200 characters'
  [[ $line =~ $re ]] || die "forbidden character in: $line"
  read -r -a w <<< "$line"
  case ${w[0]:-} in
    cat) ((${#w[@]} == 2)) && [[ ${w[1]} =~ ^/proc/net/bonding/bond[0-9]{1,2}$ ]] && return 0 ;;
    ethtool)
      { ((${#w[@]} == 2)) && host_if_ok "${w[1]}"; } ||
        { ((${#w[@]} == 3)) && [[ ${w[1]} == -S || ${w[1]} == -i ]] && host_if_ok "${w[2]}"; } && return 0 ;;
    ip) host_ip_ok && return 0 ;;
  esac
  die "not an allowed host command: $line"
}

json_string_list() {
  local first=1 item
  printf '['
  for item in "$@"; do
    ((first)) || printf ','
    first=0
    printf '"%s"' "$item"
  done
  printf ']'
}

# ---------------------------------------------------------------- lab actions

list_labs() {
  local dir lab nodes running first=1
  printf '['
  if [[ -d $LABS ]]; then
    for dir in "$LABS"/*/; do
      [[ -d $dir ]] || continue
      lab=$(basename "$dir")
      valid_lab_name "$lab" && [[ -f $dir/$lab.clab.yml ]] || continue
      nodes=$(find "$dir/nodes" -mindepth 1 -maxdepth 1 -type f | wc -l)
      running=$(docker ps -q --filter "label=containerlab=$lab" | wc -l)
      ((first)) || printf ','
      first=0
      printf '{"name":"%s","nodes":%d,"running_containers":%d}' "$lab" "$nodes" "$running"
    done
  fi
  printf ']\n'
}

create_lab() {
  valid_lab_name "${1:-}" || die 'invalid lab name'
  local lab=$1 dir="$LABS/$1" tmp verb a b c d extra node count ceos=0 ceos_img='' spec
  local -A kinds=() used=() images=()
  local -a order=() links=()
  [[ -d $LABS ]] || die "$LABS is missing; run install-remote.sh"
  [[ ! -e $dir ]] || die "lab $lab already exists"
  count=$(find "$LABS" -mindepth 1 -maxdepth 1 -type d ! -name '.*' | wc -l)
  ((count < MAX_LABS)) || die "at most $MAX_LABS labs may be defined; delete one first"
  spec=$(read_stdin "$MAX_SPEC_BYTES")
  while read -r verb a b c d extra; do
    [[ -n ${verb:-} ]] || continue
    [[ -z ${extra:-} ]] || die 'malformed spec line'
    case $verb in
      node)
        valid_node_name "$a" || die "invalid node name: $a"
        [[ -z ${kinds[$a]:-} ]] || die "duplicate node: $a"
        [[ $b == frr || $b == ceos || $b == host ]] || die "unsupported node kind: $b"
        # Only a host takes a third word: the name of a registered image.
        [[ -z ${d:-} ]] && [[ $b == host || -z ${c:-} ]] || die 'malformed node line'
        if [[ $b == host ]]; then images[$a]=$(host_image "${c:-}"); fi
        kinds[$a]=$b
        order+=("$a")
        [[ $b != ceos ]] || ceos=$((ceos + 1))
        ;;
      link)
        [[ -n ${kinds[$a]:-} && -n ${kinds[$c]:-} ]] || die 'link references an unknown node'
        [[ $a != "$c" ]] || die 'a link cannot connect a node to itself'
        valid_iface "$b" && valid_iface "$d" || die 'invalid link interface'
        [[ -z ${used[$a:$b]:-} && -z ${used[$c:$d]:-} ]] || die "interface used twice: $a:$b or $c:$d"
        used[$a:$b]=1
        used[$c:$d]=1
        links+=("$a $b $c $d")
        ;;
      *) die "unknown spec keyword: $verb" ;;
    esac
  done <<< "$spec"
  ((${#order[@]} >= 1 && ${#order[@]} <= MAX_NODES)) || die "a lab needs 1-$MAX_NODES nodes"
  ((ceos <= MAX_CEOS_PER_LAB)) || die "at most $MAX_CEOS_PER_LAB cEOS nodes per lab"
  if ((ceos)); then
    ceos_img=$(ceos_image)
    [[ -n $ceos_img ]] || die 'this lab host has no cEOS image; import one as ceos:<version> (see README), or use frr nodes'
  fi
  ((${#links[@]} <= MAX_LINKS)) || die "at most $MAX_LINKS links per lab"

  tmp="$LABS/.tmp-$lab-$$"
  rm -rf "$tmp"
  mkdir -p "$tmp/nodes" "$tmp/ifaces" "$tmp/meta"
  {
    printf 'name: %s\ntopology:\n  nodes:\n' "$lab"
    for node in "${order[@]}"; do
      mkdir -p "$tmp/configs/$node"
      printf '%s\n' "${kinds[$node]}" > "$tmp/nodes/$node"
      : > "$tmp/ifaces/$node"
      if [[ ${kinds[$node]} == frr ]]; then
        printf 'zebra=yes\nospfd=yes\nbgpd=yes\nstaticd=yes\nvtysh_enable=yes\n' > "$tmp/configs/$node/daemons"
        printf 'ospf6d=yes\nisisd=yes\nripd=yes\nbfdd=yes\nvrrpd=yes\n' >> "$tmp/configs/$node/daemons"
        printf 'ospf6d_options=" -A ::1"\nisisd_options="  -A 127.0.0.1"\nripd_options="   -A 127.0.0.1"\n' >> "$tmp/configs/$node/daemons"
        printf 'bfdd_options="   -A 127.0.0.1"\nvrrpd_options="  -A 127.0.0.1"\n' >> "$tmp/configs/$node/daemons"
        printf 'zebra_options="  -A 127.0.0.1 -s 90000000"\nospfd_options="  -A 127.0.0.1"\n' >> "$tmp/configs/$node/daemons"
        printf 'bgpd_options="  -A 127.0.0.1"\nstaticd_options="  -A 127.0.0.1"\n' >> "$tmp/configs/$node/daemons"
        printf 'service integrated-vtysh-config\n' > "$tmp/configs/$node/vtysh.conf"
        printf 'frr defaults traditional\nhostname %s\nservice integrated-vtysh-config\n' "$node" > "$tmp/configs/$node/frr.conf"
        printf '    %s:\n      kind: linux\n      image: %s\n      binds:\n' "$node" "$FRR_IMAGE"
        printf '        - configs/%s/daemons:/etc/frr/daemons\n' "$node"
        printf '        - configs/%s/frr.conf:/etc/frr/frr.conf\n' "$node"
        printf '        - configs/%s/vtysh.conf:/etc/frr/vtysh.conf\n' "$node"
      elif [[ ${kinds[$node]} == ceos ]]; then
        printf 'hostname %s\n' "$node" > "$tmp/configs/$node/startup.partial.cfg"
        printf '    %s:\n      kind: arista_ceos\n      image: %s\n' "$node" "$ceos_img"
        printf '      startup-config: configs/%s/startup.partial.cfg\n' "$node"
      else
        printf '    %s:\n      kind: linux\n      image: %s\n' "$node" "${images[$node]}"
      fi
    done
    if ((${#links[@]})); then
      printf '  links:\n'
      for spec in "${links[@]}"; do
        read -r a b c d <<< "$spec"
        printf '%s\n' "$b" >> "$tmp/ifaces/$a"
        printf '%s\n' "$d" >> "$tmp/ifaces/$c"
        printf '    - endpoints: ["%s:%s", "%s:%s"]\n      mtu: %d\n' "$a" "$b" "$c" "$d" "$LINK_MTU"
      done
    fi
  } > "$tmp/$lab.clab.yml"
  mv "$tmp" "$dir"
  printf 'created lab %s with %d nodes and %d links\n' "$lab" "${#order[@]}" "${#links[@]}"
}

put_config() {
  require_lab "${1:-}"
  require_node "${2:-}"
  require_router
  local input line lines=0 target
  ! lab_running || die "lab $LAB is deployed; destroy it before replacing startup configuration"
  input=$(read_stdin "$MAX_CONFIG_BYTES")
  while IFS= read -r line; do
    line=${line%$'\r'}
    lines=$((lines + 1))
    check_line "$line" startup
  done <<< "$input"
  ((lines <= MAX_CONFIG_LINES)) || die "configuration longer than $MAX_CONFIG_LINES lines"
  case $KIND in
    frr) target="$LAB_DIR/configs/$NODE/frr.conf" ;;
    ceos) target="$LAB_DIR/configs/$NODE/startup.partial.cfg" ;;
  esac
  printf '%s\n' "$input" > "$target.tmp"
  mv "$target.tmp" "$target"
  printf 'stored startup configuration for %s (%d lines)\n' "$NODE" "$lines"
}

delete_lab() {
  require_lab "${1:-}"
  ! lab_running || die "lab $LAB is deployed; destroy it first"
  rm -rf -- "$LAB_DIR"
  printf 'deleted lab definition %s\n' "$LAB"
}

deploy() {
  require_lab "${1:-}"
  local wanted running
  ! lab_running || die "lab $LAB is already deployed"
  wanted=$(grep -lx ceos "$LAB_DIR"/nodes/* 2>/dev/null | wc -l || true)
  running=$(docker ps -q --filter label=clab-node-kind=arista_ceos | wc -l)
  ((wanted + running <= MAX_CEOS_RUNNING)) ||
    die "deploying would run $((wanted + running)) cEOS nodes; the lab host limit is $MAX_CEOS_RUNNING"
  cd "$LAB_DIR"
  clab deploy -t "$TOPO"
}

destroy() {
  require_lab "${1:-}"
  cd "$LAB_DIR"
  clab destroy -t "$TOPO" --cleanup
}

inspect_lab() {
  require_lab "${1:-}"
  local ids
  ids=$(docker ps -aq --filter "label=containerlab=$LAB")
  [[ -n $ids ]] || return 0
  # Tab-separated: node, state, start time, management IPv4.
  # shellcheck disable=SC2086 # one container id per word
  docker inspect --format \
    '{{index .Config.Labels "clab-node-name"}}	{{.State.Status}}	{{.State.StartedAt}}	{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' \
    $ids
}

# One "key=value" line per fact, for the MCP server's check_setup. An empty
# value means missing. Read-only.
doctor() {
  printf 'helper_version=%s\n' "$HELPER_VERSION"
  printf 'docker=%s\n' "$(docker version --format '{{.Server.Version}}' 2>/dev/null || true)"
  printf 'containerlab=%s\n' "$(clab version 2>/dev/null | sed -n 's/^ *version: *//p' || true)"
  printf 'containerlab_runs_as=%s\n' "$(type -P clab >/dev/null && printf installed || printf 'container %s' "$CLAB_IMAGE")"
  printf 'lab_storage=%s\n' "$([[ -d $LABS && -w $LABS ]] && printf ok || true)"
  printf 'labs_defined=%s\n' "$(find "$LABS" -mindepth 1 -maxdepth 1 -type d ! -name '.*' 2>/dev/null | wc -l)"
  printf 'labs_max=%s\n' "$MAX_LABS"
  printf 'memory_available_mb=%s\n' "$(awk '/^MemAvailable/ {print int($2 / 1024)}' /proc/meminfo)"
  printf 'frr_image=%s\n' "$(docker image inspect "$FRR_IMAGE" >/dev/null 2>&1 && printf '%s' "$FRR_IMAGE" || true)"
  printf 'ceos_image=%s\n' "$(ceos_image)"
  printf 'host_image=%s\n' "$(docker image inspect "$HOST_IMAGE" >/dev/null 2>&1 && printf '%s' "$HOST_IMAGE" || true)"
  # name=ref pairs, comma-separated; a registered image that is not on the lab host is marked.
  printf 'extra_images=%s\n' "$(extra_images | while read -r name ref; do
    docker image inspect "$ref" >/dev/null 2>&1 || ref="$ref(missing)"
    printf '%s=%s,' "$name" "$ref"
  done)"
}

meta_key() {
  [[ ${1:-} == topology || ${1:-} == state ]] || die 'meta key must be topology or state'
}

meta_get() {
  require_lab "${1:-}"
  meta_key "${2:-}"
  [[ ! -f $LAB_DIR/meta/$2.json ]] || cat "$LAB_DIR/meta/$2.json"
}

meta_put() {
  require_lab "${1:-}"
  meta_key "${2:-}"
  local input
  input=$(read_stdin "$MAX_META_BYTES")
  printf '%s\n' "$input" > "$LAB_DIR/meta/$2.json.tmp"
  mv "$LAB_DIR/meta/$2.json.tmp" "$LAB_DIR/meta/$2.json"
  printf 'ok\n'
}

# ------------------------------------------------------------- node actions

ready() {
  require_lab "${1:-}"
  require_node "${2:-}"
  require_running
  # A host has nothing to load: it is ready as soon as it runs.
  if [[ $KIND == host ]]; then
    printf 'ready\n'
    return
  fi
  # Not grep -q: it stops reading at the first match, and under pipefail the
  # broken pipe would then report a ready router as booting.
  if cli 'show running-config' 2>/dev/null | grep -x "hostname $NODE" >/dev/null; then
    printf 'ready\n'
  else
    printf 'booting\n'
  fi
}

show() {
  require_lab "${1:-}"
  require_node "${2:-}"
  require_router
  local format=${3:-} command=${4:-}
  local re='^show( [A-Za-z0-9./:_,=+-]+){0,16}$'
  [[ $format == text || $format == json ]] || die 'format must be text or json'
  ((${#command} <= 200)) || die 'command longer than 200 characters'
  [[ $command =~ $re ]] ||
    die 'only plain "show ..." commands are allowed (no pipes, redirects or special characters)'
  require_running
  case $KIND:$format in
    frr:text) docker exec "$CONTAINER" vtysh -c "$command" ;;
    frr:json) docker exec "$CONTAINER" vtysh -c "$command json" ;;
    ceos:text) docker exec "$CONTAINER" Cli -p 15 -c "$command" ;;
    ceos:json) docker exec "$CONTAINER" Cli -p 15 -c "$command | json" ;;
  esac
}

configure() {
  require_lab "${1:-}"
  require_node "${2:-}"
  require_router
  local input line
  local -a lines=() args=()
  input=$(read_stdin "$MAX_CONFIG_BYTES")
  while IFS= read -r line; do
    line=${line%$'\r'}
    [[ -n ${line//[[:space:]]/} ]] || continue
    check_line "$line" session
    lines+=("$line")
  done <<< "$input"
  ((${#lines[@]} >= 1)) || die 'no configuration lines given'
  ((${#lines[@]} <= MAX_SESSION_LINES)) || die "at most $MAX_SESSION_LINES lines per change"
  require_running
  case $KIND in
    frr)
      args=(-c 'configure terminal')
      for line in "${lines[@]}"; do args+=(-c "$line"); done
      docker exec "$CONTAINER" vtysh "${args[@]}"
      ;;
    ceos)
      # Each validated line is newline-free, so joining cannot inject commands.
      docker exec "$CONTAINER" Cli -p 15 -c "$(printf 'configure\n'; printf '%s\n' "${lines[@]}"; printf 'end')"
      ;;
  esac
}

config_diff() {
  require_lab "${1:-}"
  require_node "${2:-}"
  require_router
  require_running
  case $KIND in
    # frr-reload's test mode prints the commands that would turn the running
    # configuration back into the startup file, i.e. a semantic diff.
    frr) docker exec "$CONTAINER" /usr/lib/frr/frr-reload.py --test /etc/frr/frr.conf 2>/dev/null |
      sed -n '/^Lines To /,$p' ;;
    ceos) docker exec "$CONTAINER" Cli -p 15 -c 'show running-config diffs' ;;
  esac
}

restore_node() {
  require_lab "${1:-}"
  require_node "${2:-}"
  require_router
  require_running
  local iface
  case $KIND in
    frr) docker exec "$CONTAINER" /usr/lib/frr/frr-reload.py --reload /etc/frr/frr.conf >/dev/null 2>&1 ||
      die "frr-reload failed on $NODE" ;;
    ceos) docker exec "$CONTAINER" Cli -p 15 -c 'configure replace flash:startup-config' ;;
  esac
  while IFS= read -r iface; do
    [[ -n $iface ]] || continue
    if [[ $KIND == frr ]]; then
      docker exec "$CONTAINER" ip link set dev "$iface" mtu "$LINK_MTU" up
    fi
    docker exec "$CONTAINER" sh -c 'tc qdisc del dev "$1" root 2>/dev/null || true' _ "$iface" 2>/dev/null || true
  done < "$LAB_DIR/ifaces/$NODE"
  printf 'restored %s to its startup configuration, link state and link quality\n' "$NODE"
}

link_state() {
  require_lab "${1:-}"
  require_node "${2:-}"
  require_node_iface "${3:-}"
  [[ ${4:-} == up || ${4:-} == down ]] || die 'state must be up or down'
  [[ $KIND == frr ]] || die 'kernel link state can only be changed on FRR nodes (cEOS re-asserts it)'
  require_running
  docker exec "$CONTAINER" ip link set dev "$3" "$4"
  printf '%s %s is %s\n' "$NODE" "$3" "$4"
}

link_mtu() {
  require_lab "${1:-}"
  require_node "${2:-}"
  require_node_iface "${3:-}"
  valid_uint "${4:-}" 576 9000 || die 'mtu must be 576-9000'
  [[ $KIND == frr ]] || die 'kernel MTU can only be changed on FRR nodes'
  require_running
  # Bounce the link so routing protocols renegotiate with the new MTU.
  docker exec "$CONTAINER" ip link set dev "$3" down
  docker exec "$CONTAINER" ip link set dev "$3" mtu "$4"
  docker exec "$CONTAINER" ip link set dev "$3" up
  printf '%s %s mtu is %s\n' "$NODE" "$3" "$4"
}

netem() {
  require_lab "${1:-}"
  require_node "${2:-}"
  require_node_iface "${3:-}"
  require_running
  case ${4:-} in
    set)
      valid_uint "${5:-}" 0 5000 || die 'delay must be 0-5000 ms'
      valid_uint "${6:-}" 0 1000 || die 'jitter must be 0-1000 ms'
      valid_uint "${7:-}" 0 100 || die 'loss must be 0-100 percent'
      clab tools netem set -n "$CONTAINER" -i "$3" --delay "${5}ms" --jitter "${6}ms" --loss "$7"
      ;;
    reset) clab tools netem reset -n "$CONTAINER" -i "$3" ;;
    *) die 'netem mode must be set or reset' ;;
  esac
}

# Hard-resets one BGP session. Used after repairs: FRR backs off for minutes
# after repeated OPEN rejections, which would otherwise delay grading.
bgp_clear() {
  require_lab "${1:-}"
  require_node "${2:-}"
  require_router
  valid_ip_literal "${3:-}" || die 'peer must be a literal IP address'
  require_running
  case $KIND in
    frr) docker exec "$CONTAINER" vtysh -c "clear bgp $3" ;;
    ceos) docker exec "$CONTAINER" Cli -p 15 -c "clear ip bgp $3" ;;
  esac
}

ping_node() {
  require_lab "${1:-}"
  require_node "${2:-}"
  valid_ip_literal "${3:-}" || die 'destination must be a literal IPv4 or IPv6 address'
  valid_uint "${4:-}" 1 20 || die 'count must be 1-20'
  local -a args=(-c "$4" -W 1 -i 0.2)
  if [[ -n ${5:-} ]]; then
    valid_ip_literal "$5" || die 'source must be a literal IP address'
    args+=(-I "$5")
  fi
  require_running
  # ping exits non-zero on loss; the caller parses the statistics instead.
  docker exec "$CONTAINER" ping "${args[@]}" "$3" 2>&1 || true
}

ping_sweep() {
  require_lab "${1:-}"
  require_node "${2:-}"
  valid_ip_literal "${3:-}" || die 'source must be a literal IP address'
  local src=$3 dest
  shift 3
  (($# >= 1 && $# <= MAX_NODES)) || die "give 1-$MAX_NODES destinations"
  for dest in "$@"; do
    valid_ip_literal "$dest" || die "invalid destination: $dest"
  done
  require_running
  for dest in "$@"; do
    (
      if docker exec "$CONTAINER" ping -c 2 -W 1 -i 0.2 -I "$src" "$dest" >/dev/null 2>&1; then
        printf '%s ok\n' "$dest"
      else
        printf '%s fail\n' "$dest"
      fi
    ) &
  done
  wait
}

traceroute_node() {
  require_lab "${1:-}"
  require_node "${2:-}"
  valid_ip_literal "${3:-}" || die 'destination must be a literal IPv4 or IPv6 address'
  local -a args=(-n -w 1 -q 1 -m 15)
  if [[ -n ${4:-} ]]; then
    valid_ip_literal "$4" || die 'source must be a literal IP address'
    args+=(-s "$4")
  fi
  require_running
  docker exec "$CONTAINER" traceroute "${args[@]}" "$3" 2>&1 || true
}

# Runs checked network commands on a host node, in order, stopping at the first
# failure. Every line is checked before any runs.
host_net() {
  require_lab "${1:-}"
  require_node "${2:-}"
  [[ $KIND == host ]] || die "$NODE is a router: use show and configure for it"
  local input line out rc
  local -a lines=() words
  input=$(read_stdin 8192)
  while IFS= read -r line; do
    line=${line%$'\r'}
    [[ -n ${line//[[:space:]]/} ]] || continue
    check_host_line "$line"
    lines+=("$line")
  done <<< "$input"
  ((${#lines[@]} >= 1 && ${#lines[@]} <= 50)) || die 'give 1-50 commands'
  require_running
  for line in "${lines[@]}"; do
    read -r -a words <<< "$line"
    printf '$ %s\n' "$line"
    rc=0
    out=$(docker exec "$CONTAINER" "${words[@]}" 2>&1) || rc=$?
    [[ -z $out ]] || printf '%s\n' "$out"
    if ((rc)); then
      [[ $out != *'Unknown device type'* ]] ||
        printf 'note: the lab host kernel has not loaded this device type; a person with sudo on the lab host can load it, e.g. sudo modprobe bonding (or 8021q, dummy)\n'
      printf '(exit %s; the remaining commands were not run)\n' "$rc"
      return 0
    fi
  done
}

# Sourced (by tests/check-line.sh): define the functions, run nothing.
[[ ${BASH_SOURCE[0]} == "$0" ]] || return 0

action=${1:-}
(($# > 0)) && shift
case "$action" in
  doctor) (($# == 0)) || die 'invalid arguments'; doctor ;;
  list-labs) (($# == 0)) || die 'invalid arguments'; list_labs ;;
  create-lab) (($# == 1)) || die 'invalid arguments'; create_lab "$1" ;;
  put-config) (($# == 2)) || die 'invalid arguments'; put_config "$1" "$2" ;;
  delete-lab) (($# == 1)) || die 'invalid arguments'; delete_lab "$1" ;;
  deploy) (($# == 1)) || die 'invalid arguments'; deploy "$1" ;;
  destroy) (($# == 1)) || die 'invalid arguments'; destroy "$1" ;;
  inspect) (($# == 1)) || die 'invalid arguments'; inspect_lab "$1" ;;
  meta-get) (($# == 2)) || die 'invalid arguments'; meta_get "$1" "$2" ;;
  meta-put) (($# == 2)) || die 'invalid arguments'; meta_put "$1" "$2" ;;
  ready) (($# == 2)) || die 'invalid arguments'; ready "$1" "$2" ;;
  show) (($# == 4)) || die 'invalid arguments'; show "$1" "$2" "$3" "$4" ;;
  configure) (($# == 2)) || die 'invalid arguments'; configure "$1" "$2" ;;
  config-diff) (($# == 2)) || die 'invalid arguments'; config_diff "$1" "$2" ;;
  restore-node) (($# == 2)) || die 'invalid arguments'; restore_node "$1" "$2" ;;
  link-state) (($# == 4)) || die 'invalid arguments'; link_state "$1" "$2" "$3" "$4" ;;
  link-mtu) (($# == 4)) || die 'invalid arguments'; link_mtu "$1" "$2" "$3" "$4" ;;
  netem) (($# == 4 || $# == 7)) || die 'invalid arguments'; netem "$@" ;;
  bgp-clear) (($# == 3)) || die 'invalid arguments'; bgp_clear "$1" "$2" "$3" ;;
  ping) (($# == 4 || $# == 5)) || die 'invalid arguments'; ping_node "$@" ;;
  ping-sweep) (($# >= 4)) || die 'invalid arguments'; ping_sweep "$@" ;;
  traceroute) (($# == 3 || $# == 4)) || die 'invalid arguments'; traceroute_node "$@" ;;
  host-net) (($# == 2)) || die 'invalid arguments'; host_net "$1" "$2" ;;
  *) die 'invalid action' ;;
esac
