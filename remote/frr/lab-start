#!/bin/bash
# Entry point for lab-dojo FRR nodes: prepares the kernel for routing labs,
# starts the device watcher, then starts FRR exactly as the stock image does.

tune() {
  sysctl -qw "$1" 2>/dev/null || echo "lab-start: could not set $1" >&2
}

# A container forwards IPv4 by default but not IPv6.
tune net.ipv4.ip_forward=1
tune net.ipv6.conf.all.forwarding=1
# Devices created later (subinterfaces, VRRP macvlans) get IPv6 like the links.
tune net.ipv6.conf.default.disable_ipv6=0
# VRRP: only the interface that owns an address answers ARP for it. Without
# this every router answers for the virtual IP with its own MAC, backups too.
tune net.ipv4.conf.all.arp_ignore=1
tune net.ipv4.conf.all.arp_announce=2
# VRRP: a backup's virtual interface is held link-down and carries the same
# subnet as the real one, so never route through a link-down interface.
tune net.ipv4.conf.all.ignore_routes_with_linkdown=1
tune net.ipv4.conf.default.ignore_routes_with_linkdown=1
tune net.ipv6.conf.all.ignore_routes_with_linkdown=1
tune net.ipv6.conf.default.ignore_routes_with_linkdown=1

(while true; do /usr/local/sbin/lab-netdev-sync; sleep 2; done) &

exec /usr/lib/frr/docker-start
